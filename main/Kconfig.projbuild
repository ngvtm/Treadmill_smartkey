menu "Example Configuration"

    config EXAMPLE_PEER_ADDR
        string "Peer Address"
        default "ADDR_ANY"
        help
            Enter the peer address in aa:bb:cc:dd:ee:ff form to connect to a specific peripheral

    config EXAMPLE_EXTENDED_ADV
        bool
        depends on SOC_BLE_50_SUPPORTED && BT_NIMBLE_50_FEATURE_SUPPORT
        default y if SOC_ESP_NIMBLE_CONTROLLER
        select BT_NIMBLE_EXT_ADV
        prompt "Enable Extended Adv"
        help
            Use this option to enable extended advertising in the example.
            If this option is disabled, ensure config BT_NIMBLE_EXT_ADV is
            also disabled from Nimble stack menuconfig

    config EXAMPLE_INIT_DEINIT_LOOP
        bool
        prompt "Perform init deinit of nimble stack in a loop"
        help
            Enable this flag, to perform only stack Init and Deinit in a loop.

    config EXAMPLE_ENCRYPTION
        bool
        prompt "Enable Link Encryption"
        help
            This enables bonding and encryption after connection has been established.

    config EXAMPLE_USE_CI_ADDRESS
        bool
        default n
        prompt "Advertise using Test address(Internal Test ONLY)"
        help
            Used for internal test ONLY.
            Use this option to advertise in a specific random address.
endmenu

menu "Smartkey Control"

    config TREADMILL_CTRL_ON_CONFIRM_TIMEOUT_MS
        int "ON confirm timeout: status must confirm ON within (ms)"
        default 2000
        range 500 10000
        help
            Phase 1, S1.2: sending ON no longer turns control on
            immediately. A status with running=1 must arrive within
            this window, or control stays OFF. No auto-retry.

    config TREADMILL_CTRL_STATUS_STALE_MS
        int "Status staleness: no status within (ms) means signal lost"
        default 2000
        range 500 10000
        help
            Phase 1, S1.2: a connected server that stops sending
            status is treated as signal lost — the display shows
            MAT TIN HIEU and control locks until a fresh status
            arrives.

endmenu

menu "Smartkey TFT Display"

    choice TFT_PANEL_DRIVER
        prompt "TFT panel driver IC (2.4 inch, 240x320, SPI)"
        default TFT_PANEL_ILI9341
        help
            The generic 2.4" 240x320 SPI modules (often marked
            v1.3, usually with XPT2046 touch fitted but unused here)
            are almost always ILI9341. If the screen stays white or
            colors look inverted after flashing, switch to ST7789 -
            no code change needed.

        config TFT_PANEL_ILI9341
            bool "ILI9341"

        config TFT_PANEL_ST7789
            bool "ST7789"

    endchoice

    config TFT_SPI_HZ
        int "TFT SPI clock (Hz)"
        default 40000000
        range 1000000 80000000
        help
            40 MHz is a safe write clock for both ILI9341 and
            ST7789 modules on short jumper wires; lower it to
            20 MHz if long wires cause noise/sparkles.

endmenu
